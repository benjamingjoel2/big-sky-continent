---
interface Props { sources: { label: string; url: string }[]; updated?: string }
const { sources, updated } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-title">
    <h2 id="sources-title">Sources</h2>
    {updated && <p class="meta">Checked and last updated {updated}. Rules, fees and travel advice change: check the official source before you book or travel.</p>}
    <ol>
      {sources.map((s) => (
        <li><a href={s.url} rel="nofollow">{s.label}</a> <span class="host">{new URL(s.url).hostname.replace(/^www\./, '')}</span></li>
      ))}
    </ol>
  </section>
)}
<style>
  .sources { max-width: 42rem; margin-top: 2.5rem; border-top: 1px solid var(--line); padding-top: 1.5rem; font-size: 0.92rem; }
  .sources h2 { font-size: 1.3rem; }
  .sources ol { padding-left: 1.3rem; }
  .sources li { margin-bottom: 0.5rem; overflow-wrap: anywhere; }
  .host { color: var(--muted); font-size: 0.85rem; display: block; }
</style>
