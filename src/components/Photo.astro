---
import { Picture } from 'astro:assets';
import { photo } from '../lib/photos';
interface Props { name: string; alt: string; widths?: number[]; sizes?: string; eager?: boolean; credit?: boolean; class?: string; aspect?: string }
const { name, alt, widths = [480, 800, 1200, 1600], sizes = '100vw', eager = false, credit = true, class: cls, aspect } = Astro.props;
const p = photo(name);
const ws = widths.filter((w) => w <= p.image.width);
---
<figure class:list={['photo', cls]}>
  <div class="photo-frame" style={aspect ? `aspect-ratio:${aspect}` : undefined}>
    <Picture src={p.image} alt={alt} widths={ws} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="jpg"
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} />
  </div>
  {credit && (
    <figcaption class="credit">
      Photo: <a href={p.meta.page} rel="nofollow">{p.meta.author}</a>, {p.meta.license_url ? <a href={p.meta.license_url} rel="license nofollow">{p.meta.license}</a> : p.meta.license}, via Wikimedia Commons
    </figcaption>
  )}
</figure>
<style>
  .photo { margin: 0; }
  .photo-frame { overflow: hidden; background: var(--ochre-soft); border-radius: var(--radius); }
  .photo-frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
