---
import '@fontsource/newsreader/latin-500.css';
import '@fontsource/newsreader/latin-600.css';
import '@fontsource/newsreader/latin-500-italic.css';
import '@fontsource-variable/inter/wght.css';
import { site, disclosure, categories, regions } from '../data/site';
import { graph, breadcrumbs as bc } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: { name: string; path: string }[];
  schema?: object[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  preloadImage?: { srcset: string; sizes: string; type: string };
}
const { title, description, path, crumbs = [], schema = [], ogImage, ogType = 'website', preloadImage } = Astro.props;
const canonical = new URL(path, site.url).href;
const fullTitle = path === '/' ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const allCrumbs = [{ name: 'Home', path: '/' }, ...crumbs];
const ld = graph(bc(allCrumbs), ...schema);
const og = ogImage ? new URL(ogImage, site.url).href : undefined;
const nav = [
  { name: 'Destinations', path: '/destinations/' },
  { name: categories.safari.name, path: categories.safari.path },
  { name: categories['gorillas-primates'].name, path: categories['gorillas-primates'].path },
  { name: categories['beach-islands'].name, path: categories['beach-islands'].path },
  { name: categories.itineraries.name, path: categories.itineraries.path },
  { name: categories['travel-tips'].name, path: categories['travel-tips'].path },
  { name: 'About', path: '/about/' },
];
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#FBF8F2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-row">
        <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
          <span class="wm-name">Big Sky Continent</span>
          <span class="wm-by">by Tourground</span>
        </a>
        <details class="menu">
          <summary>Menu</summary>
          <nav aria-label="Main">
            <ul>{nav.map((n) => <li><a href={n.path} aria-current={current(n.path)}>{n.name}</a></li>)}</ul>
          </nav>
        </details>
        <nav class="nav-wide" aria-label="Main">
          <ul>{nav.map((n) => <li><a href={n.path} aria-current={current(n.path)}>{n.name}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    {crumbs.length > 0 && (
      <nav class="wrap crumbs" aria-label="Breadcrumb">
        <ol>
          {allCrumbs.map((c, i) => (
            <li>{i < allCrumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-name">Big Sky Continent</p>
          <p>{disclosure.footerShort}</p>
          <p><a href={site.publisher.url} class="published-by">{disclosure.publishedBy}</a></p>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <p class="footer-head">Destinations</p>
          <ul>{Object.values(regions).map((r) => <li><a href={r.path}>{r.name}</a></li>)}</ul>
        </div>
        <div>
          <p class="footer-head">Stories</p>
          <ul>
            {Object.values(categories).map((c) => <li><a href={c.path}>{c.name}</a></li>)}
            <li><a href="/stories/">All stories</a></li>
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-head">About</p>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/authors/">Authors</a></li>
            <li><a href="/disclosure/">Disclosure</a></li>
            <li><a href="/photo-credits/">Photo credits</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/cookies/">Cookies</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <p>Big Sky Continent · bigskycontinent.tourground.com · {disclosure.publishedBy}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #fbf8f2;
    --surface: #ffffff;
    --ink: #24211c;
    --muted: #5b554b;
    --line: #e3dccf;
    --ochre: #c98b2b;
    --ochre-ink: #85560f;
    --ochre-soft: #f4e7cd;
    --green: #3e5a2b;
    --green-deep: #2e4420;
    --green-soft: #e5ebd9;
    --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --wrap: 72rem;
    --gutter: 1rem;
    --radius: 6px;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 400 1.0625rem/1.65 var(--sans);
    text-rendering: optimizeLegibility;
  }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--green); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  a:hover { color: var(--green-deep); text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--ochre); outline-offset: 2px; border-radius: 2px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.18; letter-spacing: -0.01em; color: var(--ink); margin: 0 0 0.5em; }
  h1 { font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem); }
  h2 { font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem); }
  h3 { font-size: 1.2rem; }
  p { margin: 0 0 1em; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--gutter); }
  @media (min-width: 48rem) { :root { --gutter: 2rem; } }
  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: #fff; padding: 0.6rem 1rem; z-index: 10; }
  .skip:focus { left: 0.5rem; top: 0.5rem; color: #fff; }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .masthead { background: var(--surface); border-bottom: 1px solid var(--line); border-top: 4px solid var(--ochre); }
  .masthead-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; position: relative; }
  .wordmark { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; line-height: 1.1; padding: 0.5rem 0; }
  .wordmark:hover { color: var(--ink); }
  .wm-name { font-family: var(--serif); font-weight: 600; font-size: 1.4rem; }
  .wm-by { font-size: 0.75rem; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
  .nav-wide { display: none; }
  .nav-wide ul, .menu ul { list-style: none; margin: 0; padding: 0; }
  .nav-wide ul { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: flex-end; }
  .nav-wide a, .menu a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
  .nav-wide a:hover, .menu a:hover { color: var(--green); text-decoration: underline; }
  .nav-wide a[aria-current='page'], .menu a[aria-current='page'] { color: var(--green); text-decoration: underline; text-decoration-color: var(--ochre); text-decoration-thickness: 2px; }
  .menu summary { list-style: none; cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 0.6rem 0.9rem; border: 1px solid var(--line); border-radius: var(--radius); min-height: 44px; display: flex; align-items: center; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { background: var(--green-soft); }
  .menu nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--surface); border-bottom: 1px solid var(--line); z-index: 5; padding: 0.5rem var(--gutter) 1rem; box-shadow: 0 8px 16px rgba(36, 33, 28, 0.08); }
  .menu li a { display: block; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 64rem) { .menu { display: none; } .nav-wide { display: block; } }

  .crumbs ol { list-style: none; padding: 0; margin: 1rem auto 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; font-size: 0.875rem; color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }

  .footer { margin-top: 4rem; background: var(--green-deep); color: #f3efe6; font-size: 0.95rem; }
  .footer a { color: #fff; }
  .footer a:hover { color: var(--ochre-soft); }
  .footer-grid { display: grid; gap: 2rem; padding-top: 2.5rem; padding-bottom: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; } }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li { margin-bottom: 0.4rem; }
  .footer-name { font-family: var(--serif); font-size: 1.3rem; font-weight: 600; }
  .footer-head { font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.8rem; color: var(--ochre-soft); }
  .footer-base { border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: 1rem; padding-bottom: 1.5rem; font-size: 0.85rem; }
  .footer-base p { margin: 0; }

  .eyebrow { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ochre-ink); margin-bottom: 0.5rem; }
  .eyebrow a { color: var(--ochre-ink); text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .section { margin-top: 3rem; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 2px solid var(--ink); padding-bottom: 0.5rem; margin-bottom: 1.5rem; }
  .section-head h2 { margin: 0; }
  .grid { display: grid; gap: 2rem 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
  .button { display: inline-flex; align-items: center; min-height: 44px; padding: 0.6rem 1.2rem; background: var(--green); color: #fff; text-decoration: none; font-weight: 600; border-radius: var(--radius); }
  .button:hover { background: var(--green-deep); color: #fff; text-decoration: none; }
  .button-ghost { background: transparent; color: var(--green); border: 2px solid var(--green); }
  .button-ghost:hover { background: var(--green-soft); color: var(--green-deep); }
  .credit { font-size: 0.78rem; color: var(--muted); margin-top: 0.4rem; }
  .credit a { color: var(--muted); }
  .page-intro { max-width: 44rem; margin-top: 1.5rem; }
  .lede { font-size: 1.15rem; color: var(--muted); }
  .prose { max-width: 42rem; }
  .prose h2 { margin-top: 2.2rem; }
  .prose h3 { margin-top: 1.6rem; }
  .prose ul, .prose ol { padding-left: 1.3rem; }
  .prose li { margin-bottom: 0.4rem; }
  .prose blockquote { margin: 1.5rem 0; padding-left: 1rem; border-left: 3px solid var(--ochre); color: var(--muted); }
  .prose table { border-collapse: collapse; width: 100%; font-size: 0.95rem; display: block; overflow-x: auto; }
  .prose th, .prose td { text-align: left; border-bottom: 1px solid var(--line); padding: 0.5rem 0.75rem 0.5rem 0; vertical-align: top; }
  .prose a { overflow-wrap: anywhere; }
</style>
